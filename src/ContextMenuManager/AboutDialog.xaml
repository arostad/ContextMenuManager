<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ContextMenuManager.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About Context Menu Manager"
    CloseButtonText="Close"
    DefaultButton="Close"
    Opened="OnOpened">

    <StackPanel Spacing="16">
        <!-- Top row: icon tile, name, version, project link -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border VerticalAlignment="Top" Padding="8" CornerRadius="12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Image x:Name="AppIcon" Width="64" Height="64" AutomationProperties.Name="Context Menu Manager icon" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Context Menu Manager" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Text="Version 0.1.0" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Hyperlink x:Name="ProjectLink" Click="OnProjectClick">GitHub project page</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <TextBlock TextWrapping="Wrap"
                   Text="Turn third-party right-click menu entries on or off, in both the Windows 11 menu and the classic menu." />

        <StackPanel Spacing="4">
            <TextBlock TextWrapping="Wrap">
                <Run Text="App created by " /><Hyperlink x:Name="AuthorLink" Click="OnAuthorClick">Andy Rostad</Hyperlink>
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
                <Run Text="Released under the " /><Hyperlink x:Name="LicenseLink" Click="OnLicenseClick">MIT License</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}">
                <Hyperlink x:Name="BackupsLink" Click="OnBackupsClick">Open backups folder</Hyperlink>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</ContentDialog>

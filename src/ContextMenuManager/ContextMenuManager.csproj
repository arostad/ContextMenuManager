<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ContextMenuManager</RootNamespace>
    <AssemblyName>ContextMenuManager</AssemblyName>
    <Product>Context Menu Manager</Product>
    <AssemblyTitle>Context Menu Manager</AssemblyTitle>
    <Authors>Andy Rostad</Authors>
    <Copyright>Copyright (c) 2026 Andy Rostad. MIT License.</Copyright>
    <Version>0.1.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Size: English-only satellite resources and no PDBs. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!-- Ship path is dotnet publish (build\package.ps1). Partial IL trimming trims only the framework and
         Windows SDK projection assemblies; the app's own code is kept whole. JSON uses a source-generated context. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the Windows App SDK parts this app uses. The metapackage also pulls in AI, ML (onnxruntime, DirectML),
         Search and Widgets, which added about 75 MB to the self-contained output. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Remove="Assets\**" />
    <Content Include="Assets\app.ico;Assets\app.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Local end-to-end update testing only (build\package.ps1 -UpdateTestOverride). Release builds compile the
       null override in Services\UpdateChecker.Release.cs and never contain UpdateTest\. -->
  <ItemGroup Condition="'$(UpdateTestOverride)' == 'true'">
    <Compile Remove="Services\UpdateChecker.Release.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdateTestOverride)' != 'true'">
    <Compile Remove="UpdateTest\**" />
  </ItemGroup>
  <!-- Unpackaged publish (EnableMsixTooling=false) leaves out the compiled XAML (.xbf) and the app's .pri, and the
       app then fails with XamlParseException at launch. Copy them from the build output. -->
  <Target Name="CopyXamlAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_CmmXaml Include="$(OutDir)*.xbf;$(OutDir)$(TargetName).pri" />
    </ItemGroup>
    <Error Condition="'@(_CmmXaml)' == ''" Text="No .xbf or .pri found in $(OutDir)." />
    <Copy SourceFiles="@(_CmmXaml)" DestinationFolder="$(PublishDir)" />
  </Target>
  <!-- Debugger and crash-dump helpers the app never loads at run time. -->
  <Target Name="PruneDebugRuntime" AfterTargets="Publish">
    <ItemGroup>
      <_CmmPrune Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll;$(PublishDir)mscordaccore.dll;$(PublishDir)mscordaccore_*.dll;$(PublishDir)mscordbi.dll;$(PublishDir)createdump.exe;$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_CmmPrune)" />
  </Target>
</Project>
